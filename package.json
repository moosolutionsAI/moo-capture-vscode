{
  "name": "moo-capture",
  "displayName": "Moo Capture",
  "description": "Low-latency game streaming client for VS Code — connects to Vibeshine for GPU-accelerated screen capture",
  "version": "0.1.1",
  "publisher": "MooKeyboardAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MooKeyboardAI/moo-capture-vscode"
  },
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onCommand:moo-capture.connect",
    "onCommand:moo-capture.disconnect",
    "onCommand:moo-capture.shutdown",
    "onCommand:moo-capture.setupVirtualDisplay",
    "onCommand:moo-capture.toggleMute",
    "onCommand:moo-capture.showStats",
    "onCommand:moo-capture.openSettings",
    "onCommand:moo-capture.tuneStream"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "moo-capture.connect",
        "title": "Connect to Vibeshine",
        "icon": "$(game)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.disconnect",
        "title": "Disconnect",
        "icon": "$(debug-disconnect)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.shutdown",
        "title": "Shutdown Everything",
        "icon": "$(stop-circle)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.setupVirtualDisplay",
        "title": "Setup Virtual Display (Headless Mode)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.toggleMute",
        "title": "Toggle Stream Audio Mute",
        "icon": "$(mute)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.showStats",
        "title": "Show Latency Stats",
        "icon": "$(pulse)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.openSettings",
        "title": "Open Settings",
        "icon": "$(settings-gear)",
        "category": "Moo Capture"
      },
      {
        "command": "moo-capture.tuneStream",
        "title": "Tune Stream (Game / Quality / Custom)",
        "icon": "$(rocket)",
        "category": "Moo Capture"
      }
    ],
    "keybindings": [
      {
        "command": "moo-capture.connect",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "moo-capture.toggleMute",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "configuration": {
      "title": "Moo Capture",
      "properties": {
        "mooCaptureVscode.sunshineHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Vibeshine server hostname or IP address"
        },
        "mooCaptureVscode.sunshinePort": {
          "type": "number",
          "default": 47989,
          "description": "Vibeshine HTTP API port (default: 47989)"
        },
        "mooCaptureVscode.relayPort": {
          "type": "number",
          "default": 48080,
          "description": "Local port for the streaming relay (auto-managed)"
        },
        "mooCaptureVscode.resolution": {
          "type": "string",
          "default": "1920x1080",
          "enum": [
            "1280x720",
            "1920x1080",
            "2560x1440",
            "3840x2160"
          ],
          "description": "Stream resolution"
        },
        "mooCaptureVscode.fps": {
          "type": "number",
          "default": 60,
          "enum": [
            30,
            60,
            120
          ],
          "description": "Target frames per second"
        },
        "mooCaptureVscode.codec": {
          "type": "string",
          "default": "h264",
          "enum": [
            "h264",
            "hevc"
          ],
          "description": "Video codec (H.264 recommended for lowest latency)"
        },
        "mooCaptureVscode.bitrate": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Stream bitrate in Kbps"
        },
        "mooCaptureVscode.headlessMode": {
          "type": "boolean",
          "default": true,
          "description": "Use a virtual display for headless streaming (game only visible in Cursor)"
        },
        "mooCaptureVscode.virtualDisplayResolution": {
          "type": "string",
          "default": "1920x1080",
          "enum": [
            "1280x720",
            "1920x1080",
            "2560x1440"
          ],
          "description": "Resolution for the virtual display in headless mode"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "build:ext": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
